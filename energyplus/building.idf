version,24.1;

! ====================================================================
! Honeywell Eco-Loop  —  5-Zone Office Building
! EnergyPlus Input Data File (IDF)
!
! Building:   3-storey open-plan office, 900 m² floor area
! Location:   Chicago O'Hare International Airport
! HVAC:       Ideal Loads Air System with EMS-controlled setpoints
! Zones:      Core, Perimeter_N, Perimeter_S, Perimeter_E, Perimeter_W
! ====================================================================

  SimulationControl,
    Yes,                     !- Do Zone Sizing Calculation
    Yes,                     !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes;                     !- Run Simulation for Weather File Run Periods

  Building,
    EcoLoop Office Building, !- Name
    0.0,                     !- North Axis (degrees)
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value
    0.4,                     !- Temperature Convergence Tolerance Value (deltaC)
    FullExterior,            !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  Timestep,4;                !- Number of Timesteps per Hour (15-min steps)

  Site:Location,
    Chicago O'Hare,          !- Name
    41.98,                   !- Latitude (degrees)
    -87.92,                  !- Longitude (degrees)
    -6.0,                    !- Time Zone (hours)
    201.0;                   !- Elevation (m)

  RunPeriod,
    Annual,                  !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    ,                        !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    ,                        !- End Year
    Sunday,                  !- Day of Week for Start Day
    Yes,                     !- Use Weather File Holidays and Special Days
    Yes,                     !- Use Weather File DST Indicators
    No,                      !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

! ── Zones ─────────────────────────────────────────────────────────────────────

  Zone,
    Core Zone,               !- Name
    0.0,                     !- Direction of Relative North (degrees)
    0.0, 0.0, 0.0,           !- X, Y, Z Origin
    1,                       !- Type
    1,                       !- Multiplier
    autocalculate,           !- Ceiling Height (m)
    autocalculate;           !- Volume (m3)

  Zone,
    Perimeter_N Zone,
    0.0, 0.0, 0.0, 0.0, 1, autocalculate, autocalculate;

  Zone,
    Perimeter_S Zone,
    0.0, 0.0, 0.0, 0.0, 1, autocalculate, autocalculate;

  Zone,
    Perimeter_E Zone,
    0.0, 0.0, 0.0, 0.0, 1, autocalculate, autocalculate;

  Zone,
    Perimeter_W Zone,
    0.0, 0.0, 0.0, 0.0, 1, autocalculate, autocalculate;

! ── Schedules ────────────────────────────────────────────────────────────────

  ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

  ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    Continuous,              !- Numeric Type
    Temperature;             !- Unit Type

  Schedule:Compact,
    Office Occupancy,        !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.0,
    Until: 08:00, 0.2,
    Until: 09:00, 0.6,
    Until: 10:00, 0.95,
    Until: 12:00, 1.0,
    Until: 13:00, 0.7,
    Until: 14:00, 0.85,
    Until: 17:00, 1.0,
    Until: 18:00, 0.5,
    Until: 19:00, 0.2,
    Until: 24:00, 0.0,
    For: SummerDesignDay,
    Until: 24:00, 1.0,
    For: WinterDesignDay AllOtherDays,
    Until: 24:00, 0.0;

  Schedule:Compact,
    Always On,               !- Name
    Fraction,
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 1.0;

  Schedule:Compact,
    Cooling Setpoint Sched,  !- Name
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 24.0;

  Schedule:Compact,
    Heating Setpoint Sched,  !- Name
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 20.0;

! ── Internal gains ────────────────────────────────────────────────────────────

  People,
    Core People,             !- Name
    Core Zone,               !- Zone or ZoneList Name
    Office Occupancy,        !- Number of People Schedule Name
    People/Area,             !- Number of People Calculation Method
    0.1,                     !- People per Zone Floor Area (person/m2)
    ,                        !- Zone Floor Area per Person (m2/person)
    0.3,                     !- Fraction Radiant
    autocalculate,           !- Sensible Heat Fraction
    Activity Sch;            !- Activity Level Schedule Name

  Schedule:Compact,
    Activity Sch,            !- Name
    ,
    Through: 12/31,
    For: AllDays,
    Until: 24:00, 120;       !- W/person

  Lights,
    Core Lights,             !- Name
    Core Zone,
    Office Occupancy,        !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Lighting Level (W)
    10.0,                    !- Watts per Zone Floor Area (W/m2)
    ,                        !- Watts per Person
    0.0,                     !- Return Air Fraction
    0.59,                    !- Fraction Radiant
    0.2,                     !- Fraction Visible
    1.0;                     !- Fraction Replaceable

  ElectricEquipment,
    Core Equipment,          !- Name
    Core Zone,
    Office Occupancy,
    Watts/Area,
    ,
    15.0,                    !- Watts per Zone Floor Area (W/m2)
    ,
    0.0,                     !- Fraction Latent
    0.5,                     !- Fraction Radiant
    0.0;                     !- Fraction Lost

! ── HVAC: Ideal Loads (simplest valid HVAC for EnergyPlus) ───────────────────

  ZoneHVAC:IdealLoadsAirSystem,
    Core Ideal Loads,        !- Name
    ,                        !- Availability Schedule Name
    Core Zone Supply Inlet,  !- Zone Supply Air Node Name
    Core Zone Exhaust,       !- Zone Exhaust Air Node Name
    ,                        !- System Inlet Air Node Name
    50,                      !- Maximum Heating Supply Air Temperature (C)
    13,                      !- Minimum Cooling Supply Air Temperature (C)
    0.0156,                  !- Maximum Heating Supply Air Humidity Ratio (kgWater/kgDryAir)
    0.0077,                  !- Minimum Cooling Supply Air Humidity Ratio (kgWater/kgDryAir)
    NoLimit,                 !- Heating Limit
    ,                        !- Maximum Heating Air Flow Rate (m3/s)
    ,                        !- Maximum Sensible Heating Capacity (W)
    NoLimit,                 !- Cooling Limit
    ,                        !- Maximum Cooling Air Flow Rate (m3/s)
    ,                        !- Maximum Total Cooling Capacity (W)
    ,                        !- Heating Availability Schedule Name
    ,                        !- Cooling Availability Schedule Name
    ConstantSupplyHumidityRatio, !- Dehumidification Control Type
    ,                        !- Cooling Sensible Heat Ratio
    ConstantSupplyHumidityRatio, !- Humidification Control Type
    ,                        !- Design Specification Outdoor Air Object Name
    ,                        !- Outdoor Air Inlet Node Name
    ,                        !- Demand Controlled Ventilation Type
    ,                        !- Outdoor Air Economizer Type
    ,                        !- Heat Recovery Type
    ,                        !- Sensible Heat Recovery Effectiveness
    ;                        !- Latent Heat Recovery Effectiveness

  ZoneHVAC:EquipmentList,
    Core Equipment List,     !- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:IdealLoadsAirSystem, !- Zone Equipment Object Type 1
    Core Ideal Loads,        !- Zone Equipment Name 1
    1,                       !- Zone Equipment Cooling Sequence 1
    1,                       !- Zone Equipment Heating Sequence 1
    SequentialLoad,
    SequentialLoad;

  ZoneHVAC:EquipmentConnections,
    Core Zone,               !- Zone Name
    Core Equipment List,     !- Zone Conditioning Equipment List Name
    Core Zone Supply Inlet,  !- Zone Air Inlet Node or NodeList Name
    Core Zone Exhaust,       !- Zone Air Exhaust Node or NodeList Name
    Core Zone Air Node,      !- Zone Air Node Name
    Core Zone Return;        !- Zone Return Air Node or NodeList Name

! ── Thermostats ───────────────────────────────────────────────────────────────

  ThermostatSetpoint:DualSetpoint,
    Core Dual Setpoint,      !- Name
    Heating Setpoint Sched,  !- Heating Setpoint Temperature Schedule Name
    Cooling Setpoint Sched;  !- Cooling Setpoint Temperature Schedule Name

  ZoneControl:Thermostat,
    Core Thermostat,         !- Name
    Core Zone,               !- Zone or ZoneList Name
    Always On,               !- Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint, !- Control Object Type
    Core Dual Setpoint;      !- Control Name

! ── EMS Actuators (allow Python API to override setpoints) ───────────────────

  EnergyManagementSystem:Actuator,
    Core_Cool_SP,            !- Name
    Core Dual Setpoint,      !- Actuated Component Unique Name
    ThermostatSetpoint:DualSetpoint, !- Actuated Component Type
    Cooling Setpoint;        !- Actuated Component Control Type

  EnergyManagementSystem:Actuator,
    Core_Heat_SP,            !- Name
    Core Dual Setpoint,
    ThermostatSetpoint:DualSetpoint,
    Heating Setpoint;

! ── EMS Sensors ──────────────────────────────────────────────────────────────

  EnergyManagementSystem:Sensor,
    Core_Temp,               !- Name
    Core Zone,               !- Output:Variable or Output:Meter Index Key Name
    Zone Mean Air Temperature; !- Output:Variable or Output:Meter Name

  EnergyManagementSystem:Sensor,
    Site_Outdoor_Temp,
    Environment,
    Site Outdoor Air Drybulb Temperature;

! ── Output variables ─────────────────────────────────────────────────────────

  Output:Variable,
    *,
    Zone Mean Air Temperature,
    TimeStep;

  Output:Variable,
    *,
    Zone Thermostat Cooling Setpoint Temperature,
    TimeStep;

  Output:Variable,
    *,
    Zone Thermostat Heating Setpoint Temperature,
    TimeStep;

  Output:Variable,
    Environment,
    Site Outdoor Air Drybulb Temperature,
    TimeStep;

  Output:Meter,
    Electricity:Facility,
    TimeStep;

  Output:Meter,
    Cooling:Electricity,
    TimeStep;

  Output:Meter,
    Heating:Electricity,
    TimeStep;

  OutputControl:Table:Style,
    HTML;

  Output:Table:SummaryReports,
    AllSummary;

  Output:Diagnostics,
    DisplayExtraWarnings;
