# Honeywell Eco-Loop — Environment Configuration
# Copy this file to .env and edit the values as needed.
# The application works out-of-the-box with SIMULATION_MODE=true (no EnergyPlus required).

# ── Simulation ────────────────────────────────────────────────────────────────
# Set to false if you have EnergyPlus installed and want to use the real API.
SIMULATION_MODE=true

# Path to your EnergyPlus installation (only needed when SIMULATION_MODE=false)
ENERGYPLUS_PATH=C:/EnergyPlus-24-1-0

# Path to the building IDF file (relative to project root)
IDF_FILE=energyplus/building.idf

# Path to an EPW weather file (leave blank to use the built-in weather model)
WEATHER_FILE=

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# Make sure Ollama is running: `ollama serve`
# Make sure the model is pulled: `ollama pull qwen2.5:7b`
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# ── Control Loop ─────────────────────────────────────────────────────────────
# How often (wall-clock seconds) the AI agent makes a new decision
AGENT_INTERVAL_SECONDS=30

# ── API / Dashboard ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
WS_BROADCAST_INTERVAL=2.0

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001
